    "prettier": "2.8.8",
    "eslint": "^9.18.0",
    "@eslint/js": "^9.18.0",
    "typescript-eslint": "^8.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.4.0",
    "@playwright/test": "1.57.0",
