    "react-dom": "^18.2.0",
    "react-router-dom": "7.18.2",
    "react-i18next": "^15.5.3",
    "i18next": "^26.7.1",
    "lodash": "4.18.1",
    "classnames": "^2.3.1",
    "antd": "4.24.16",
    "@ant-design/icons": "^4.8.3",
    "@untitledui/icons": "^0.0.21",
    "@fontsource-variable/inter": "^5.2.8",
    "react-aria": "^3.47.0",
    "react-aria-components": "^1.16.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
