# Copy values into IDEA's Environment variables editor; Java does not load this file.
# Replace credentials and the existing PostgreSQL database name before use.
DB_DRIVER_CLASS=org.postgresql.Driver
DB_SCHEME=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
OM_DATABASE=openmetadata_db
DB_USER=governance_context_v208
DB_USER_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_PARAMS=currentSchema=governance_context_v208
DB_CONNECTION_POOL_MAX_SIZE=15
DB_CONNECTION_POOL_MIN_SIZE=2
DB_CONNECTION_POOL_MIN_IDLE=2
DB_CONNECTION_POOL_INITIAL_SIZE=2
OPENMETADATA_CLUSTER_NAME=governance_context_v208
SERVER_HOST=0.0.0.0
SERVER_ADMIN_HOST=127.0.0.1
SERVER_PORT=8585
SERVER_ADMIN_PORT=8586
AUTHENTICATION_PROVIDER=basic
AUTHENTICATION_PUBLIC_KEYS=[http://localhost:8585/api/v1/system/config/jwks]
SEARCH_TYPE=elasticsearch
ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_CLUSTER_ALIAS=governance_context_v208
PIPELINE_SERVICE_CLIENT_ENABLED=false
RDF_ENABLED=true
RDF_STORAGE_TYPE=FUSEKI
RDF_ENDPOINT=http://127.0.0.1:3030/governance_context_v208
RDF_DATASET=governance_context_v208
RDF_REMOTE_USERNAME=REPLACE_WITH_FUSEKI_USER
RDF_REMOTE_PASSWORD=REPLACE_WITH_FUSEKI_PASSWORD
ASSET_UPLOADER_ENABLE=true
ASSET_UPLOADER_PROVIDER=s3
ASSET_UPLOADER_S3_ENDPOINT=http://127.0.0.1:9000
ASSET_UPLOADER_S3_BUCKET_NAME=governance-context-v208
ASSET_UPLOADER_S3_REGION=us-east-1
ASSET_UPLOADER_S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
ASSET_UPLOADER_S3_SECRET_KEY=REPLACE_WITH_S3_SECRET_KEY
ASSET_UPLOADER_S3_PREFIX_PATH=governance-context-v208
SEMANTIC_SEARCH_ENABLED=false
LLM_PROVIDER=noop
